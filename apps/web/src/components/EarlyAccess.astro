---
// Early-access form: POST to the API's public /v1/waitlist (CORS allows this site).
import { ArrowRight, CircleCheck, LoaderCircle } from "@lucide/astro";

const API = "https://airdrop-api.guhcostan.dev";
const MAU = [
  ["<10k", "Under 10K"],
  ["10k-100k", "10K – 100K"],
  ["100k-1m", "100K – 1M"],
  [">1m", "Over 1M"],
];
---

<form class="grid content-start gap-4" data-access data-api={API} novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="access-email" class="text-sm font-medium">Work email</label>
      <input id="access-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="input" />
    </div>
    <div class="grid gap-2">
      <label for="access-app" class="text-sm font-medium">App name <span class="font-normal text-muted-foreground">(optional)</span></label>
      <input id="access-app" name="app" type="text" maxlength="100" placeholder="My App" class="input" />
    </div>
  </div>
  <fieldset class="grid gap-2">
    <legend class="mb-2 text-sm font-medium">Monthly active users</legend>
    <div class="flex flex-wrap gap-2">
      {
        MAU.map(([value, label], i) => (
          <label class="badge h-9 cursor-pointer gap-2 px-3 text-sm has-[:checked]:border-brand has-[:checked]:bg-accent" data-variant="outline">
            <input type="radio" name="mau" value={value} class="accent-[var(--color-brand)]" checked={i === 1} />
            {label}
          </label>
        ))
      }
    </div>
  </fieldset>
  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="hidden" aria-hidden="true">
    <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn" data-size="lg" data-submit>
      <span data-idle class="inline-flex items-center gap-2">Request early access <ArrowRight /></span>
      <span data-busy class="hidden items-center gap-2"><LoaderCircle class="animate-spin" /> Sending…</span>
    </button>
    <p class="text-sm text-muted-foreground" data-status aria-live="polite">No credit card required. See our <a class="underline underline-offset-4" href="/privacy/">privacy policy</a>.</p>
  </div>
  <div class="hidden items-start gap-3 rounded-xl border border-ok/30 bg-ok/10 p-4 text-sm" data-done>
    <CircleCheck class="mt-0.5 size-5 flex-none text-ok" />
    <div>
      <p class="font-medium text-foreground">You're on the list.</p>
      <p class="text-muted-foreground">We'll email you an app token and a link to the getting started guide.</p>
    </div>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-access]")) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const idle = form.querySelector<HTMLElement>("[data-idle]")!;
    const busy = form.querySelector<HTMLElement>("[data-busy]")!;
    const done = form.querySelector<HTMLElement>("[data-done]")!;
    const setBusy = (on: boolean) => {
      submit.disabled = on;
      idle.classList.toggle("hidden", on);
      busy.classList.toggle("hidden", !on);
      busy.classList.toggle("inline-flex", on);
    };
    const hint = status.textContent;
    form.querySelector("[name=email]")!.addEventListener("input", () => {
      status.textContent = hint;
      status.classList.remove("text-bad");
    });
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = "Please enter a valid email.";
        status.classList.add("text-bad");
        form.querySelector<HTMLInputElement>("[name=email]")!.focus();
        return;
      }
      status.classList.remove("text-bad");
      setBusy(true);
      try {
        const res = await fetch(`${form.dataset.api}/v1/waitlist`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, app: data.get("app"), mau: data.get("mau"), company: data.get("company") }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelectorAll<HTMLElement>(":scope > :not([data-done])").forEach((el) => el.classList.add("hidden"));
        done.classList.remove("hidden");
        done.classList.add("flex");
      } catch {
        status.textContent = "Something went wrong. Please try again in a moment.";
        status.classList.add("text-bad");
      } finally {
        setBusy(false);
      }
    });
  }
</script>
