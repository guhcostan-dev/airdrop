---
// 100 devices; the release reaches staging, then 5%, 25% and 100% of production. One crash is rolled back on that device.
const stages = [
  { pct: 0, label: "staging · team devices", cmd: "airdrop release -p ios --channel staging" },
  { pct: 5, label: "5% of production", cmd: "airdrop release -p ios --rollout 5" },
  { pct: 25, label: "25% · 1 crash, rolled back on that device", cmd: "airdrop rollout <id> 25" },
  { pct: 100, label: "100% · everyone", cmd: "airdrop rollout <id> 100" },
];
---

<div class="rounded-2xl border bg-card p-6" data-rollout data-stages={JSON.stringify(stages)}>
  <div class="grid grid-cols-10 gap-2" aria-hidden="true">
    {Array.from({ length: 100 }, (_, i) => <span class="dot on aspect-square rounded-full bg-muted" data-i={i} />)}
  </div>
  <div class="mt-5 flex items-baseline justify-between gap-3">
    <p class="text-sm font-medium" data-label aria-live="polite">{stages[3].label}</p>
    <p class="font-mono text-2xl font-semibold tabular-nums" data-pct>100%</p>
  </div>
  <p class="mt-1 truncate font-mono text-xs text-muted-foreground" data-cmd>{stages[3].cmd}</p>
</div>

<style>
  .dot { transition: background-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease; }
  .dot.on { background: var(--color-brand); }
  .dot.team { background: oklch(0.82 0.11 210); }
  .dot.bad { background: var(--color-bad); transform: scale(0.8); box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-bad) 30%, transparent); }
</style>

<script>
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  for (const root of document.querySelectorAll<HTMLElement>("[data-rollout]")) {
    const stages: { pct: number; label: string; cmd: string }[] = JSON.parse(root.dataset.stages!);
    const dots = [...root.querySelectorAll<HTMLElement>(".dot")];
    // Deterministic shuffle (seeded LCG) so the rollout looks spread across the fleet.
    const order = dots.map((_, i) => i);
    let seed = 42;
    const rand = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(rand() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    const label = root.querySelector<HTMLElement>("[data-label]")!;
    const pctEl = root.querySelector<HTMLElement>("[data-pct]")!;
    const cmd = root.querySelector<HTMLElement>("[data-cmd]")!;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      dots.forEach((d) => d.classList.add("on"));
      continue;
    }
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(root);
    dots.forEach((d) => d.classList.remove("on"));

    (async () => {
      for (;;) {
        while (!visible || document.hidden) await sleep(300);
        dots.forEach((d) => d.classList.remove("on", "team", "bad"));
        let lit = 0;
        for (const s of stages) {
          label.textContent = s.label;
          cmd.textContent = s.cmd;
          pctEl.textContent = `${s.pct}%`;
          if (s.pct === 0) {
            order.slice(0, 3).forEach((i) => dots[i].classList.add("team"));
          } else {
            order.slice(0, 3).forEach((i) => dots[i].classList.remove("team"));
            for (; lit < s.pct; lit++) {
              dots[order[lit]].classList.add("on");
              await sleep(s.pct === 100 ? 18 : 60);
            }
            if (s.pct === 25) {
              const crashed = dots[order[17]];
              crashed.classList.add("bad");
              await sleep(1100);
              crashed.classList.remove("bad", "on"); // back on the previous bundle
            }
          }
          await sleep(1700);
        }
        await sleep(1800);
      }
    })();
  }
</script>
