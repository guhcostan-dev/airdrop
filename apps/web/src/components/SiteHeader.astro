---
import logo from "../assets/logo.svg?raw";
import GithubIcon from "./GithubIcon.astro";
import { GITHUB } from "../utils/site";
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-[#070911]/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-white">
      <span class="inline-flex size-8 [&>svg]:size-full" set:html={logo} />
      <span class="text-lg font-bold tracking-tight">Airdrop</span>
      <span class="hidden sm:inline-flex items-center gap-1 rounded-full border border-brand/30 bg-brand/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-[#C4B5FD]">
        v0.2
      </span>
    </a>
    <nav class="flex items-center gap-1 text-sm">
      <a href="/#playground" class="btn hidden lg:inline-flex" data-variant="ghost" data-size="sm">Playground</a>
      <a href="/#features" class="btn hidden md:inline-flex" data-variant="ghost" data-size="sm">Features</a>
      <a href="/#compare" class="btn hidden md:inline-flex" data-variant="ghost" data-size="sm">Benchmarks</a>
      <a href="/#pricing" class="btn hidden md:inline-flex" data-variant="ghost" data-size="sm">Pricing</a>
      <a href="/#security" class="btn hidden lg:inline-flex" data-variant="ghost" data-size="sm">Security</a>
      <a href="/docs/" class="btn hidden sm:inline-flex" data-variant="ghost" data-size="sm">Docs</a>
      <a href="/dashboard/" class="btn hidden sm:inline-flex" data-variant="ghost" data-size="sm">Dashboard</a>
      <a href={GITHUB} class="btn" data-variant="ghost" data-size="icon-sm" aria-label="GitHub"><GithubIcon /></a>
      <a href="/#access" class="btn ml-1" data-size="sm">Get access</a>
    </nav>
  </div>
</header>
