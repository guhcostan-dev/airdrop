---
import { GITHUB } from "../utils/site";
---

<header class="sticky top-0 z-30 border-b border-white/8 bg-[#0b0b0c]/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href="/" class="inline-flex items-center gap-2.5 font-medium tracking-tight text-[#f3f3f1]" aria-label="Airdrop Home">
      <img src="/pumpy/assets/airdrop-mark.svg" alt="" width="28" height="28" />
      <span class="text-base">Airdrop</span>
    </a>

    <nav class="hidden items-center gap-6 text-xs text-[#b5b5b3] sm:flex" aria-label="Navegação principal">
      <a href="/#demonstracao" class="transition-colors hover:text-[#f3f3f1]">Como funciona</a>
      <a href="/#inspecao" class="transition-colors hover:text-[#f3f3f1]">Inspeção</a>
      <a href="/#recursos" class="transition-colors hover:text-[#f3f3f1]">Recursos</a>
      <a href="/docs/getting-started/" class="transition-colors hover:text-[#f3f3f1]">Docs</a>
      <a href="/dashboard/" class="transition-colors hover:text-[#f3f3f1]">Console</a>
      <a href={GITHUB} class="transition-colors hover:text-[#f3f3f1]">GitHub</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/" class="rounded-full border border-white/12 bg-[#171718] px-3.5 py-1.5 text-xs font-medium text-[#f3f3f1] transition-colors hover:bg-[#202021]">
        ← Início
      </a>
    </div>
  </div>
</header>
