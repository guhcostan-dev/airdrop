---
// Looping story: a checkout bug in production, `airdrop release` in the terminal, the fix lands on the phone.
import { Check, CircleAlert, Timer } from "@lucide/astro";
import logo from "../assets/logo.svg?raw";

const command = 'airdrop release -p ios -m "Fix checkout total"';
---

<div class="hero-demo mx-auto grid max-w-6xl items-center gap-8 px-5 pt-10 lg:grid-cols-[1fr_auto]" data-hero-demo data-command={command}>
  <!-- Terminal -->
  <div class="card min-w-0 gap-0 py-0 shadow-2xl shadow-brand/10">
    <div class="flex items-center gap-2 border-b px-4 py-3">
      <span class="size-2.5 rounded-full bg-muted"></span>
      <span class="size-2.5 rounded-full bg-muted"></span>
      <span class="size-2.5 rounded-full bg-muted"></span>
      <span class="ml-2 font-mono text-xs text-muted-foreground">~/shop-app</span>
      <span class="demo-chip ml-auto inline-flex items-center gap-1.5 rounded-full border bg-background px-2.5 py-0.5 text-xs text-muted-foreground" data-chip>
        <Timer class="size-3.5 text-ok" /> bug to fix in production: <b class="font-medium text-foreground">3 min</b>
      </span>
    </div>
    <div class="h-[300px] overflow-hidden p-5 text-left font-mono text-[13px] leading-7 sm:h-[280px]">
      <p><span class="text-muted-foreground">$</span> <span data-typed></span><span class="demo-caret" data-caret></span></p>
      <p class="demo-line text-muted-foreground" data-line="1">Releasing Shop • ios • runtime 2.4.0 • channel production</p>
      <p class="demo-line text-muted-foreground" data-line="2">$ react-native bundle + hermesc -O … <span class="text-ok">done</span></p>
      <p class="demo-line" data-line="3">38 files (2.41 MB), <span class="tok-hl">1 changed</span>, 37 already on server</p>
      <p class="demo-line flex items-center gap-3" data-line="4">
        <span class="text-muted-foreground">↑ main.jsbundle</span>
        <span class="relative h-1.5 w-40 overflow-hidden rounded-full bg-muted"><span class="demo-progress absolute inset-y-0 left-0 rounded-full bg-brand" data-progress></span></span>
        <span class="text-muted-foreground">612 KB gz</span>
      </p>
      <p class="demo-line" data-line="5"><span class="text-ok">✔</span> Published <span class="tok-id">7c070454</span> · signed · 100% rollout</p>
      <p class="demo-line mt-3" data-line="6"><span class="text-muted-foreground">$</span> <span class="demo-caret"></span></p>
    </div>
  </div>

  <!-- Phone -->
  <div class="relative mx-auto h-[460px] w-[230px] rounded-[38px] border bg-card p-2.5 shadow-2xl shadow-brand/15" aria-hidden="true">
    <div class="absolute top-[18px] left-1/2 z-10 h-5 w-[70px] -translate-x-1/2 rounded-full bg-black"></div>
    <div class="relative h-full overflow-hidden rounded-[30px] bg-background px-4 pt-14 text-left" data-phone data-state="bug">
      <p class="text-[11px] tracking-wide text-muted-foreground uppercase">Cart</p>
      <div class="mt-3 grid gap-2.5 text-[13px]">
        <div class="flex justify-between"><span>Running shoes</span><span class="text-muted-foreground">$38.00</span></div>
        <div class="flex justify-between"><span>Socks</span><span class="text-muted-foreground">$4.00</span></div>
        <div class="my-1 h-px bg-border"></div>
        <div class="flex justify-between font-medium">
          <span>Total</span>
          <span class="relative">
            <span class="phone-bug text-bad">$NaN</span>
            <span class="phone-fixed absolute right-0">$42.00</span>
          </span>
        </div>
      </div>
      <div class="phone-bug mt-5 flex items-start gap-2 rounded-xl border border-bad/30 bg-bad/10 p-2.5 text-[11px] text-bad">
        <CircleAlert class="size-3.5 flex-none" /> Checkout failed: total is invalid
      </div>
      <div class="phone-fixed mt-5 flex items-center gap-2 rounded-xl border border-ok/30 bg-ok/10 p-2.5 text-[11px] text-ok">
        <Check class="size-3.5 flex-none" /> Ready to pay
      </div>
      <div class="mt-4 rounded-xl py-2.5 text-center text-[13px] font-medium transition-colors duration-500 phone-cta">Place order</div>

      <div class="demo-toast absolute inset-x-2.5 bottom-4 flex items-center gap-2.5 rounded-2xl border bg-card/95 p-2.5 backdrop-blur" data-toast>
        <span class="inline-flex size-7 flex-none [&>svg]:size-full" set:html={logo} />
        <div class="leading-tight">
          <p class="text-[13px] font-medium">Update ready</p>
          <p class="text-[11px] text-muted-foreground">Fix checkout total · applies now</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-line { opacity: 0; transform: translateY(4px); transition: opacity 0.35s ease, transform 0.35s ease; }
  .demo-line.is-on { opacity: 1; transform: none; }
  .demo-caret { display: inline-block; width: 0.55em; height: 1.1em; margin-left: 1px; vertical-align: -0.2em; background: currentColor; animation: caret 1s steps(1) infinite; }
  .demo-progress { width: var(--p, 0%); transition: width 0.12s linear; }
  .demo-chip { opacity: 0; transform: translateY(-4px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .demo-chip.is-on { opacity: 1; transform: none; }
  .demo-toast { transform: translateY(140%); opacity: 0; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease; }
  .demo-toast.is-on { transform: none; opacity: 1; }
  [data-phone] .phone-bug, [data-phone] .phone-fixed { transition: opacity 0.5s ease, filter 0.5s ease; }
  [data-phone][data-state="bug"] .phone-fixed { opacity: 0; filter: blur(4px); }
  [data-phone][data-state="fixed"] .phone-bug { opacity: 0; filter: blur(4px); }
  [data-phone][data-state="fixed"] div.phone-bug { display: none; }
  [data-phone][data-state="bug"] div.phone-fixed { display: none; }
  [data-phone][data-state="bug"] .phone-cta { background: var(--muted); color: var(--muted-foreground); }
  [data-phone][data-state="fixed"] .phone-cta { background: var(--color-brand); color: white; }
  @keyframes caret { 50% { opacity: 0; } }
  @media (max-width: 1023px) { [data-phone] { } }
</style>

<script>
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const root of document.querySelectorAll<HTMLElement>("[data-hero-demo]")) {
    const command = root.dataset.command ?? "";
    const typed = root.querySelector<HTMLElement>("[data-typed]")!;
    const caret = root.querySelector<HTMLElement>("[data-caret]")!;
    const lines = [...root.querySelectorAll<HTMLElement>("[data-line]")];
    const progress = root.querySelector<HTMLElement>("[data-progress]")!;
    const phone = root.querySelector<HTMLElement>("[data-phone]")!;
    const toast = root.querySelector<HTMLElement>("[data-toast]")!;
    const chip = root.querySelector<HTMLElement>("[data-chip]")!;

    const finalState = () => {
      typed.textContent = command;
      caret.hidden = true;
      lines.forEach((l) => l.classList.add("is-on"));
      progress.style.setProperty("--p", "100%");
      phone.dataset.state = "fixed";
      chip.classList.add("is-on");
    };
    if (reduced) {
      finalState();
      continue;
    }

    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    const waitVisible = async () => {
      while (!visible || document.hidden) await sleep(250);
    };

    (async function loop() {
      for (;;) {
        // Reset: production has a bug.
        typed.textContent = "";
        caret.hidden = false;
        lines.forEach((l) => l.classList.remove("is-on"));
        progress.style.setProperty("--p", "0%");
        phone.dataset.state = "bug";
        toast.classList.remove("is-on");
        chip.classList.remove("is-on");
        await sleep(1400);
        await waitVisible();

        for (const ch of command) {
          typed.textContent += ch;
          await sleep(28 + Math.random() * 40);
        }
        caret.hidden = true;
        await sleep(350);
        for (const line of lines.slice(0, 3)) {
          line.classList.add("is-on");
          await sleep(450);
        }
        lines[3].classList.add("is-on");
        for (let p = 0; p <= 100; p += 4) {
          progress.style.setProperty("--p", `${p}%`);
          await sleep(28);
        }
        await sleep(200);
        lines[4].classList.add("is-on");
        await sleep(500);
        toast.classList.add("is-on");
        await sleep(1100);
        phone.dataset.state = "fixed";
        await sleep(900);
        toast.classList.remove("is-on");
        lines[5].classList.add("is-on");
        chip.classList.add("is-on");
        await sleep(4200);
      }
    })();
  }
</script>
