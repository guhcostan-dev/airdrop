---
import { API, GITHUB } from "../utils/site";

const title = "Airdrop — Sua release. Uma conversa.";
const description =
  "Atualizações Over-the-Air para React Native. Assinatura criptográfica, rollout canário e rollback automático na sua AWS e Cloudflare.";
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Bytecode Hermes, assinatura Ed25519 e rollout canário para React Native." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://airdrop.guhcostan.dev/" />
    <meta property="og:site_name" content="Airdrop" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content="https://airdrop.guhcostan.dev/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://airdrop.guhcostan.dev/og.png" />
    <link rel="canonical" href="https://airdrop.guhcostan.dev/" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/pumpy/theme-init.js"></script>
    <link rel="stylesheet" href="/pumpy/styles.css" />
    <link rel="stylesheet" href="/pumpy/nutrition-sun.css" />
    <link rel="stylesheet" href="/pumpy/nutrition-widgets.css" />
    <script is:inline src="/pumpy/character.js" defer></script>
    <script is:inline src="/pumpy/header.js" defer></script>
    <script is:inline src="/pumpy/beta.js" defer></script>
    <script is:inline src="/pumpy/scroll.js" defer></script>
    <script is:inline src="/pumpy/story.js" defer></script>
    <script is:inline src="/pumpy/nutrition-sun.js" defer></script>
    <script is:inline src="/pumpy/nutrition-story.js" defer></script>
  </head>
  <body>
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></symbol>
      <symbol id="plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
      <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
      <symbol id="menu" viewBox="0 0 24 24"><path d="M4 8h16M4 16h16" /></symbol>
      <symbol id="close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6" /></symbol>
    </svg>

    <header class="header">
      <div class="header-inner">
        <a class="header-logo" href="/" aria-label="Início do Airdrop">
          <img class="brand-mark" src="/pumpy/assets/airdrop-mark.svg" width="44" height="44" alt="Símbolo do Airdrop" />
        </a>
        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#demonstracao">Como funciona</a>
          <a href="#inspecao">Inspeção</a>
          <a href="#recursos">Recursos</a>
          <a href="/docs/getting-started/">Docs</a>
          <a href="/dashboard/">Console</a>
        </nav>
        <div class="header-actions">
          <button class="menu-toggle icon-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
            <svg class="icon"><use href="#menu" /></svg>
          </button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Navegação móvel" hidden>
        <a href="#demonstracao">Como funciona</a>
        <a href="#inspecao">Inspeção</a>
        <a href="#recursos">Recursos</a>
        <a href="/docs/getting-started/">Docs</a>
        <a href="/dashboard/">Console</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
          <h1 id="hero-title" aria-label="Conheça Airdrop">
            <span class="hero-title-word">Conheça</span>
            <button class="hero-mascot pumpy-live" type="button" aria-label="Cumprimentar o Airdrop" title="Dê um oi ao Airdrop"></button>
            <span class="hero-title-word">Airdrop</span>
          </h1>
          <p class="hero-description">
            Seu sistema de updates OTA para React Native.<br class="desktop-break" /> No iOS e no Android. Na sua infra.
          </p>
          <form method="post" action={`${API}/v1/waitlist`} class="beta-form" data-beta-form data-api={API} aria-label="Solicitar acesso ao Airdrop">
            <label class="beta-label" for="hero-email">Receba seu token de acesso</label>
            <div class="beta-input-row">
              <input id="hero-email" name="email" type="email" autocomplete="email" placeholder="Seu melhor e-mail" maxlength="254" required />
              <button class="button" type="submit">Quero começar <span aria-hidden="true">↗</span></button>
            </div>
            <div class="beta-trap" aria-hidden="true"><label>Website<input name="company" type="text" tabindex="-1" autocomplete="off" /></label></div>
            <p class="beta-status" role="status" aria-live="polite"></p>
            <noscript>Ative o JavaScript para enviar sua inscrição com segurança.</noscript>
          </form>
        </div>
      </section>

      <section class="scroll-story" id="demonstracao" aria-label="Um deploy com o Airdrop">
        <div class="story-stage">
          <div class="story-canvas">
            <div class="story-request">
              <p class="story-request-text">Publica esse hotfix do checkout em 20% da produção.</p>
              <div class="story-composer-tools">
                <span class="story-add" aria-hidden="true"><svg class="icon"><use href="#plus" /></svg></span>
                <span class="story-composer-caption">airdrop release</span>
                <button class="story-send" type="button" aria-label="Ver o envio do comando de exemplo"><svg class="icon"><use href="#arrow" /></svg></button>
              </div>
            </div>
            <div class="story-thinking" aria-hidden="true"><span class="story-dot-anchor"></span><span class="story-thinking-label">Compilando<span>…</span></span></div>
            <article class="story-answer" aria-label="Resposta do Airdrop com o pipeline de publicação OTA">
              <div class="story-answer-intro"><p>Pronto! O patch já foi compilado, assinado e entregue ao canal production.</p></div>
              <div class="story-workout">
                <div class="story-workout-heading"><p>6 etapas <span>·</span> 4,2s <span>·</span> AWS S3 + Cloudflare Edge</p></div>
                <ol class="story-exercises">
                  <li><span class="story-exercise-number">01</span><div><strong>Metro + Hermes .hbc</strong><span>Bytecode pré-compilado iOS e Android</span></div><p>1,64 MB<small>base completa</small></p></li>
                  <li><span class="story-exercise-number">02</span><div><strong>Deduplicação por SHA-256</strong><span>Somente os chunks alterados sobem</span></div><p>180 KB<small>delta comprimido</small></p></li>
                  <li><span class="story-exercise-number">03</span><div><strong>Assinatura ECDSA P-256</strong><span>Envelope canônico assinado na sua CI</span></div><p>Local<small>chave nunca sai</small></p></li>
                  <li><span class="story-exercise-number">04</span><div><strong>Storage em AWS S3</strong><span>Artefatos imutáveis na região us-east-2</span></div><p>us-east-2<small>zero lock-in</small></p></li>
                  <li><span class="story-exercise-number">05</span><div><strong>Propagação Cloudflare Edge</strong><span>Distribuição global sem taxa por egresso</span></div><p>38 ms<small>latência p50</small></p></li>
                  <li><span class="story-exercise-number">06</span><div><strong>Canário + Crash Watchdog</strong><span>Rollback nativo automático em 2 boots</span></div><p>20%<small>production</small></p></li>
                </ol>
                <p class="story-workout-note">O SDK nativo verifica a assinatura antes do boot e reverte sozinho se o JS falhar.</p>
              </div>
            </article>
          </div>
          <div class="story-footer" hidden aria-hidden="true">
            <p class="story-scroll-hint"></p>
          </div>
        </div>
      </section>

      <section class="nutrition-story" id="inspecao" aria-label="Inspecionar e publicar uma release com o Airdrop">
        <div class="nutrition-stage">
          <div class="nutrition-canvas">
            <span class="nutrition-dock" aria-hidden="true"></span>
            <div class="nutrition-composer">
              <figure class="nutrition-photo">
                <img src="/pumpy/assets/release-artifact.svg" width="900" height="900" loading="lazy" decoding="async" alt="Inspeção de diff binário Hermes bytecode v2.4.1">
                <span class="nutrition-scan" aria-hidden="true"></span>
                <span class="nutrition-pin nutrition-pin-chicken" aria-hidden="true">Hermes .hbc</span>
                <span class="nutrition-pin nutrition-pin-rice" aria-hidden="true">SHA-256 ok</span>
                <span class="nutrition-pin nutrition-pin-beans" aria-hidden="true">Ed25519</span>
                <figcaption class="nutrition-photo-result"><span>Hotfix v2.4.1</span><strong>180 <small>KB</small></strong><span>Verificado antes do upload</span></figcaption>
              </figure>
              <div class="nutrition-question"><p>Airdrop, libera para 20%?</p><button class="nutrition-send" type="button" aria-label="Ver análise do pacote de exemplo"><svg class="icon"><use href="#arrow" /></svg></button></div>
            </div>
            <div class="nutrition-analysis" aria-label="Métricas do pacote">
              <dl class="nutrition-macros"><div><dt>Rollout</dt><dd>20<span> %</span></dd></div><div><dt>Latência</dt><dd>38<span> ms</span></dd></div><div><dt>Estável</dt><dd>99,9<span> %</span></dd></div></dl>
              <button class="nutrition-save" type="button">Aplicar no canal <svg class="icon"><use href="#arrow" /></svg></button>
            </div>
            <article class="nutrition-receipt" aria-label="Exemplo de release publicada no canal">
              <div class="nutrition-diary-heading"><span>Hoje</span><p><svg class="icon"><use href="#check" /></svg> Release publicada</p></div>
              <div class="nutrition-saved-meal"><div class="nutrition-thumb-space" aria-hidden="true"></div><div><strong>v2.4.1 · Checkout</strong><span>12:30 · Hermes HBC, zstd e ECDSA P-256</span></div><p>180<small>KB</small></p></div>
              <div class="nutrition-daily"><span>Dispositivos atualizados</span><p><strong class="nutrition-total">1.280</strong><span> ativos</span></p></div>
              <div class="nutrition-progress" aria-hidden="true"><span></span></div>
              <p class="nutrition-goal">de 2.000 dispositivos</p>
            </article>
            <svg class="nutrition-track" aria-hidden="true" focusable="false"><path fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <article class="nutrition-overview" aria-label="Resumo ilustrativo do rollout: 1.280 de 2.000 dispositivos, 96% Hermes HBC, 99,8% crash-free, 94% cache hit e 38 ms de latência">
              <p class="nutrition-overview-heading">Hoje</p>
              <div class="nutrition-sun">
                <svg class="nutrition-sun-visual" viewBox="0 0 240 240" aria-hidden="true"></svg>
                <div class="nutrition-sun-center"><strong>1.280</strong><span>de 2.000 ativos</span></div>
              </div>
              <div class="nutrition-sun-metrics">
                <button type="button" data-sun-macro="0"><span class="nutrition-sun-metric-label"><span class="sun-metric-full">Hermes</span><span class="sun-metric-short" aria-hidden="true">HBC</span></span><span class="nutrition-sun-metric-value"><strong>96</strong><small>/ 100%</small></span></button>
                <button type="button" data-sun-macro="1"><span class="nutrition-sun-metric-label"><span class="sun-metric-full">Estável</span><span class="sun-metric-short" aria-hidden="true">Est.</span></span><span class="nutrition-sun-metric-value"><strong>99,8</strong><small>/ 100%</small></span></button>
                <button type="button" data-sun-macro="2"><span class="nutrition-sun-metric-label"><span class="sun-metric-full">Cache</span><span class="sun-metric-short" aria-hidden="true">CDN</span></span><span class="nutrition-sun-metric-value"><strong>94</strong><small>/ 100%</small></span></button>
                <div aria-label="Latência: 38 milissegundos"><span class="nutrition-sun-metric-label"><span class="sun-metric-full">Latência</span><span class="sun-metric-short" aria-hidden="true">Edge</span></span><span class="nutrition-sun-metric-value"><strong>38</strong><small> ms</small></span></div>
              </div>
            </article>
            <p class="nutrition-note" hidden aria-hidden="true"></p>
          </div>

          <div class="nutrition-dashboard" id="recursos" role="group" aria-label="Telemetria do Airdrop: rollout, consistência, tamanho do bundle, deploys, notificações e integrações">
            <div class="nutrition-widget-shell bento-calories" data-bento-beat="0">
              <h3 class="nutrition-widget-title">Telemetria</h3>
              <article class="nutrition-widget nutrition-widget-nutrition" aria-label="Painel mobile do Airdrop em um iPhone">
                <div class="bento-diet-device">
                  <span class="bento-diet-lock" aria-hidden="true"></span>
                  <div class="bento-diet-screen">
                    <img src="/pumpy/assets/airdrop-diet-screen.svg" alt="Painel do Airdrop com telemetria do rollout e releases recentes" width="720" height="1564" loading="lazy" decoding="async" />
                    <span class="bento-diet-island" aria-hidden="true"></span>
                    <div class="bento-diet-chart-mask" aria-hidden="true"></div>
                    <div class="widget-sun-slot"></div>
                  </div>
                </div>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-activity" data-bento-beat="1">
              <h3 class="nutrition-widget-title">Estabilidade</h3>
              <article class="nutrition-widget nutrition-widget-month" aria-label="Estabilidade em novembro: 26 dias sem rollback em 30 dias">
                <div class="widget-summary"><strong>26 dias limpos</strong><small>Novembro</small></div>
                <ol class="widget-month-grid" aria-label="Novembro de 2026: frequência diária de deploys sem rollback">
                  <li class="widget-month-day" data-level="2" title="1 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="3" title="2 nov: promoção para produção"></li>
                  <li class="widget-month-day" data-level="0" title="3 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="1" title="4 nov: staging"></li>
                  <li class="widget-month-day" data-level="2" title="5 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="3" title="6 nov: promoção 100%"></li>
                  <li class="widget-month-day" data-level="0" title="7 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="1" title="8 nov: staging"></li>
                  <li class="widget-month-day" data-level="2" title="9 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="0" title="10 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="3" title="11 nov: hotfix imediato"></li>
                  <li class="widget-month-day" data-level="2" title="12 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="1" title="13 nov: staging"></li>
                  <li class="widget-month-day" data-level="0" title="14 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="2" title="15 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="3" title="16 nov: promoção 100%"></li>
                  <li class="widget-month-day" data-level="0" title="17 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="1" title="18 nov: staging"></li>
                  <li class="widget-month-day" data-level="2" title="19 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="3" title="20 nov: promoção 100%"></li>
                  <li class="widget-month-day" data-level="0" title="21 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="1" title="22 nov: staging"></li>
                  <li class="widget-month-day" data-level="2" title="23 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="0" title="24 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="3" title="25 nov: hotfix imediato"></li>
                  <li class="widget-month-day" data-level="2" title="26 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="1" title="27 nov: staging"></li>
                  <li class="widget-month-day" data-level="0" title="28 nov: sem deploy"></li>
                  <li class="widget-month-day" data-level="2" title="29 nov: deploy canário"></li>
                  <li class="widget-month-day" data-level="3" title="30 nov: promoção 100%"></li>
                </ol>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-weight" data-bento-beat="2">
              <h3 class="nutrition-widget-title">Payload</h3>
              <article class="nutrition-widget nutrition-widget-weight" aria-label="Evolução do tamanho de download: de 1,64 MB para 180 KB">
                <div class="widget-summary"><strong>180 <span>KB</span></strong><small>−89% com diff SHA-256</small></div>
                <svg class="widget-weight-chart" viewBox="0 0 280 100" preserveAspectRatio="none" role="img" aria-labelledby="widget-weight-chart-title" aria-describedby="widget-weight-chart-description" focusable="false">
                  <title id="widget-weight-chart-title">Tamanho do pacote OTA de v2.1 a v2.4</title>
                  <desc id="widget-weight-chart-description">Queda de 1,64 MB para 180 KB por delta binário conteúdo-endereçado.</desc>
                  <defs>
                    <linearGradient id="weight-area" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="currentColor" stop-opacity=".22" />
                      <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path class="weight-area" d="M4 12 C20 12 22 24 40 22 S60 36 78 34 S100 39 114 44 S136 55 152 53 S173 67 192 64 S217 76 234 76 S260 88 276 88 L276 100 L4 100 Z" />
                  <path class="weight-line" d="M4 12 C20 12 22 24 40 22 S60 36 78 34 S100 39 114 44 S136 55 152 53 S173 67 192 64 S217 76 234 76 S260 88 276 88" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                  <circle class="weight-halo" cx="276" cy="88" r="10" /><circle class="weight-dot" cx="276" cy="88" r="3.5" />
                </svg>
                <div class="widget-chart-endpoints" aria-hidden="true"><span>v2.1</span><span>v2.4</span></div>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-training" data-bento-beat="2">
              <h3 class="nutrition-widget-title">Deploys</h3>
              <article class="nutrition-widget nutrition-widget-training" aria-label="18 deploys em quatro semanas">
                <div class="widget-summary"><strong>18 <span>deploys</span></strong><small>sem review na loja</small></div>
                <div class="widget-training-bars" role="img" aria-label="18 deploys em quatro semanas">
                  <div class="widget-training-week" aria-hidden="true"><span class="widget-training-bar-track"><span class="widget-training-bar" style="--bar-height: 50%"></span></span><span class="widget-training-label">S1</span></div>
                  <div class="widget-training-week" aria-hidden="true"><span class="widget-training-bar-track"><span class="widget-training-bar" style="--bar-height: 75%"></span></span><span class="widget-training-label">S2</span></div>
                  <div class="widget-training-week" aria-hidden="true"><span class="widget-training-bar-track"><span class="widget-training-bar" style="--bar-height: 75%"></span></span><span class="widget-training-label">S3</span></div>
                  <div class="widget-training-week" aria-hidden="true"><span class="widget-training-bar-track"><span class="widget-training-bar" style="--bar-height: 100%"></span></span><span class="widget-training-label">S4</span></div>
                </div>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-phone" data-bento-beat="1">
              <h3 class="nutrition-widget-title">No aparelho.</h3>
              <article class="nutrition-widget nutrition-widget-phone" aria-label="Airdrop no iOS e Android com verificação de assinatura e health gate">
                <div class="bento-device-crop">
                  <div class="bento-device">
                    <img class="bento-phone-image bento-phone-image-light" src="/pumpy/assets/airdrop-phone-light.svg" alt="Airdrop em um iPhone mostrando atualização verificada no tema claro" width="1400" height="1400" loading="lazy" decoding="async" />
                    <img class="bento-phone-image bento-phone-image-dark" src="/pumpy/assets/airdrop-phone-dark.svg" alt="Airdrop em um iPhone mostrando atualização verificada no tema escuro" width="1400" height="1400" loading="lazy" decoding="async" />
                  </div>
                </div>
                <div class="bento-notification-stack">
                  <div class="bento-notification">
                    <img src="/pumpy/assets/airdrop-app-icon.svg" alt="" width="28" height="28" />
                    <div><div class="bento-notification-meta"><span>Airdrop</span><small>agora</small></div><strong>Patch v2.4.1 aplicado.</strong><p>Assinatura Ed25519 verificada antes do boot.</p></div>
                  </div>
                  <div class="bento-notification">
                    <img src="/pumpy/assets/airdrop-app-icon.svg" alt="" width="28" height="28" />
                    <div><div class="bento-notification-meta"><span>Airdrop</span><small>agora</small></div><strong>Watchdog confirmou saúde.</strong><p>99,98% crash-free no canal production.</p></div>
                  </div>
                </div>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-integrations" data-bento-beat="3">
              <article class="nutrition-widget nutrition-widget-integrations" aria-label="Integrações: React Native, Expo, Hermes, Cloudflare, AWS e GitHub Actions">
                <div class="bento-integration-copy"><h3>Sua stack, conectada.</h3><p>Bare React Native ou Expo.<br />Roda na sua conta.</p></div>
                <div class="bento-integration-list">
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/react-native.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">React Native</span></div>
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/expo.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">Expo</span></div>
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/hermes.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">Hermes</span></div>
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/cloudflare.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">Cloudflare</span></div>
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/aws.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">AWS S3</span></div>
                  <div class="bento-integration"><span class="bento-integration-icon"><img src="/pumpy/assets/github.svg" alt="" width="32" height="32" loading="lazy" /></span><span class="bento-integration-name">GitHub CI</span></div>
                </div>
              </article>
            </div>

            <div class="nutrition-widget-shell bento-dock" data-bento-beat="3">
              <article class="nutrition-widget nutrition-widget-dock" aria-label="SDK nativo e CLI no fluxo de release">
                <div class="bento-dock-crop"><div class="bento-dock-device"><img src="/pumpy/assets/airdrop-phone-dock.svg" alt="Dock com ícones de Airdrop, React Native, Expo e Terminal" width="1000" height="1000" loading="lazy" decoding="async" /></div></div>
              </article>
            </div>
          </div>

          <div class="nutrition-footer" hidden aria-hidden="true">
            <span>Um comando. Tudo entregue.</span>
            <button class="nutrition-overview-trigger" type="button">Ver resumo <span aria-hidden="true">→</span></button>
            <button class="nutrition-dashboard-trigger" type="button"><span class="nutrition-dashboard-label">Ver telemetria</span> <span aria-hidden="true">→</span></button>
            <button class="nutrition-replay" type="button">Ver de novo <span aria-hidden="true">↺</span></button>
          </div>
        </div>
      </section>

