---
import "../styles/landing.css";
import "../styles/pumpy-airdrop.css";
import { PumpyStoryAndBento } from "../components/interactive/PumpyStoryAndBento";
import { InteractiveOtaPlayground } from "../components/interactive/InteractiveOtaPlayground";
import { CompetitorMatrix } from "../components/interactive/CompetitorMatrix";
import { IntegrationCodeTabs } from "../components/interactive/IntegrationCodeTabs";
import { API, GITHUB } from "../utils/site";

const title = "Airdrop — Sua release. Uma conversa.";
const description =
  "Atualizações Over-the-Air (OTA) Zero-Trust para React Native. Assinatura ECDSA P-256, rollout canário e auto-rollback nativo em um único comando.";
---

<!doctype html>
<html lang="pt-BR" data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://airdrop.guhcostan.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://airdrop.guhcostan.dev/" />
    <meta property="og:image" content="https://airdrop.guhcostan.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://airdrop.guhcostan.dev/og.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="pumpy-body">
    <!-- STICKY HEADER -> GATHERS INTO FLOATING GLASS CAPSULE ON SCROLL -->
    <header class="pumpy-header" id="site-header" data-nav-style="capsule">
      <div class="pumpy-header-inner">
        <a class="pumpy-header-logo" href="/" aria-label="Airdrop Home">
          <svg width="32" height="32" viewBox="0 0 120 120" aria-hidden="true">
            <path
              d="M22 46 C22 20, 98 20, 98 46 C98 52, 91 55, 84 53 C76 51, 68 51, 60 53 C52 51, 44 51, 36 53 C29 55, 22 52, 22 46 Z"
              fill="var(--pumpy-body)"
            />
            <line x1="33" y1="50" x2="42" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
            <line x1="87" y1="50" x2="78" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
            <rect x="26" y="56" width="68" height="50" rx="25" fill="var(--pumpy-body)" />
            <ellipse cx="47" cy="80" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
            <ellipse cx="73" cy="80" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
          </svg>
          <span>Airdrop</span>
        </a>

        <nav class="pumpy-nav" aria-label="Navegação principal">
          <a href="#demonstracao">Como funciona</a>
          <a href="#telemetria">Telemetria</a>
          <a href="#recursos">Recursos</a>
          <a href="#playground">Playground</a>
          <a href="#comparativo">Custos</a>
          <a href="/docs/getting-started/">Docs</a>
          <a href="/dashboard/">Console</a>
        </nav>

        <div class="pumpy-header-actions">
          <button
            type="button"
            class="pumpy-icon-btn"
            id="theme-toggle"
            aria-label="Alternar tema claro/escuro"
            title="Alternar tema"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
            </svg>
          </button>
          <a href="/dashboard/" class="pumpy-button pumpy-button-small">
            Abrir Console <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- HERO SECTION WITH LIVING MASCOT INSIDE H1 (PUMPY SIGNATURE) -->
      <section class="pumpy-hero" aria-labelledby="hero-title">
        <div class="pumpy-container">
          <a href="#demonstracao" class="pumpy-announcement">
            <span class="pumpy-status-dot"></span>
            <span>React Native 0.71 → 0.87+ · AWS S3 + Cloudflare Edge</span>
            <span class="pumpy-pill-arrow" aria-hidden="true">→</span>
          </a>

          <h1 id="hero-title" class="pumpy-hero-h1" aria-label="Conheça Airdrop">
            <span class="pumpy-hero-word">Conheça</span>
            <button
              class="pumpy-mascot-btn"
              id="hero-mascot-btn"
              type="button"
              aria-label="Cumprimentar o Airdrop"
              title="Dê um oi ao Airdrop"
            >
              <svg viewBox="0 0 120 120" width="100%" height="100%" style="overflow: visible; display: block;">
                <g id="hero-mascot-group">
                  <path
                    d="M22 46 C22 20, 98 20, 98 46 C98 52, 91 55, 84 53 C76 51, 68 51, 60 53 C52 51, 44 51, 36 53 C29 55, 22 52, 22 46 Z"
                    fill="var(--pumpy-body)"
                  />
                  <line x1="33" y1="50" x2="42" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
                  <line x1="87" y1="50" x2="78" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
                  <rect x="26" y="56" width="68" height="50" rx="25" fill="var(--pumpy-body)" />
                  <g id="hero-mascot-eyes">
                    <ellipse id="hero-eye-left" cx="47" cy="80" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
                    <ellipse id="hero-eye-right" cx="73" cy="80" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
                  </g>
                </g>
              </svg>
            </button>
            <span class="pumpy-hero-word">Airdrop</span>
          </h1>

          <p class="pumpy-hero-description">
            Seu parceiro de releases Over-the-Air para React Native.<br />
            No iOS e no Android. Em um único comando.
          </p>

          <!-- Pumpy-style Beta / Early Access Input Row -->
          <form class="pumpy-beta-form" data-waitlist-form aria-label="Receber token de acesso do Airdrop">
            <label class="pumpy-beta-label" for="hero-email">
              <span>Receba seu token de produção ou faça self-host agora</span>
              <span style="font-size: 11px; color: var(--mint);">Grátis até 10k MAU · MIT</span>
            </label>
            <div class="pumpy-beta-row">
              <input
                id="hero-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="Seu melhor e-mail de engenharia"
                maxlength="254"
                required
              />
              <button class="pumpy-button" type="submit">
                Quero começar <span aria-hidden="true">↗</span>
              </button>
            </div>
            <div style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);" aria-hidden="true">
              <input name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="waitlist-status" style="font-size: 12px; margin-top: 10px; color: var(--mint); display: none;"></p>
          </form>

          <div>
            <button
              type="button"
              class="pumpy-cli-pill"
              id="copy-hero-cli"
              title="Copiar comando CLI"
            >
              <span style="color: var(--mint);">$</span>
              <span>npx react-native-airdrop-cli release --platform ios --rollout 20 --sign</span>
              <span id="copy-hero-cli-badge" style="font-size: 10px; color: var(--muted); margin-left: 4px;">copiar</span>
            </button>
          </div>
        </div>
      </section>

      <!-- PUMPY CONVERSATIONAL STORY + RADIAL SUNBURST + 12-COLUMN BENTO GRID -->
      <PumpyStoryAndBento client:load />

      <!-- INTERACTIVE 4-TAB OTA SIMULATOR PLAYGROUND -->
      <section id="playground" style="padding: 110px 0 30px;">
        <div class="pumpy-container">
          <p class="pumpy-story-eyebrow">SIMULADOR INTERATIVO</p>
          <h2 class="pumpy-story-h2" style="margin-bottom: 14px;">
            Teste cada garantia antes de instalar o SDK.
          </h2>
          <p style="text-align: center; color: var(--muted); font-size: 14px; max-width: 560px; margin: 0 auto 40px;">
            Simule um hotfix em bytecode Hermes, ajuste a régua de rollout canário, dispare um crash para ver o watchdog reverter sozinho ou tente adulterar 1 byte da assinatura ECDSA P-256.
          </p>
          <InteractiveOtaPlayground client:visible />
        </div>
      </section>

      <!-- INTERACTIVE MAU CALCULATOR & COMPETITOR MATRIX -->
      <section id="comparativo" style="padding: 110px 0 30px;">
        <div class="pumpy-container">
          <p class="pumpy-story-eyebrow">ECONOMIA &amp; BENCHMARK 2026</p>
          <h2 class="pumpy-story-h2" style="margin-bottom: 14px;">
            Zero imposto por MAU. Infraestrutura na sua conta.
          </h2>
          <p style="text-align: center; color: var(--muted); font-size: 14px; max-width: 560px; margin: 0 auto 40px;">
            Compare o custo mensal real na sua AWS + Cloudflare contra EAS Update, Stallion, Revopush e o antigo CodePush.
          </p>
          <CompetitorMatrix client:visible />
        </div>
      </section>

      <!-- INTEGRATION CODE TABS -->
      <section id="integracao" style="padding: 110px 0 30px;">
        <div class="pumpy-container">
          <p class="pumpy-story-eyebrow">INTEGRAÇÃO EM 5 MINUTOS</p>
          <h2 class="pumpy-story-h2" style="margin-bottom: 14px;">
            Bare React Native ou Expo. Cinco linhas de código.
          </h2>
          <p style="text-align: center; color: var(--muted); font-size: 14px; max-width: 560px; margin: 0 auto 40px;">
            Debug continua usando o Metro normalmente. Em builds de release, o SDK nativo verifica e carrega o bundle assinado.
          </p>
          <IntegrationCodeTabs client:visible />
        </div>
      </section>

      <!-- PUMPY 2-COLUMN MINIMALIST FAQ SECTION -->
      <section class="pumpy-container">
        <div class="pumpy-faq-section" id="faq">
          <div>
            <p class="pumpy-story-eyebrow" style="text-align: left;">PERGUNTAS FREQUENTES</p>
            <h2
              style="
                font-size: clamp(30px, 3.4vw, 42px);
                line-height: 1.12;
                font-weight: 300;
                letter-spacing: -0.048em;
                margin-top: 14px;
              "
            >
              Tudo sobre segurança, Apple &amp; Google e self-hosting.
            </h2>
            <p style="color: var(--muted); font-size: 13px; line-height: 1.75; margin-top: 16px;">
              Precisa de detalhes do protocolo HTTP ou da assinatura canônica?
            </p>
            <a
              href="/docs/getting-started/"
              style="
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-top: 20px;
                font-size: 13px;
                color: var(--text);
                text-decoration: underline;
                text-underline-offset: 4px;
              "
            >
              Ler a documentação completa →
            </a>
          </div>

          <div class="pumpy-faq-list">
            <details open>
              <summary>
                <span>Isso é permitido pelas diretrizes da App Store e Google Play?</span>
                <svg class="pumpy-faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p>
                Sim. A seção 3.3.2 do Apple Developer Program e as políticas do Google Play permitem atualizações Over-the-Air de código interpretado (JavaScript/Hermes bytecode e assets) desde que não alterem a finalidade principal do aplicativo nem baixem código nativo compilado (Swift/Obj-C/Kotlin).
              </p>
            </details>
            <details>
              <summary>
                <span>O que acontece se eu publicar um bundle JS com erro fatal na inicialização?</span>
                <svg class="pumpy-faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p>
                Novas atualizações entram como <code>pendingUpdateId</code>. Antes de executar o novo bundle, o código nativo incrementa um contador de boot no disco. Se o app sofrer crash antes do JS chamar <code>Airdrop.notifyAppReady()</code>, na abertura seguinte o SDK reverte automaticamente para o bundle anterior funcional e adiciona o ID defeituoso em <code>failedUpdateIds</code>.
              </p>
            </details>
            <details>
              <summary>
                <span>Mesmo se meu servidor ou CDN for comprometido, um invasor pode injetar JS?</span>
                <svg class="pumpy-faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p>
                Não quando a assinatura de código está ativa (<code>airdrop init --sign</code>). Sua chave privada ECDSA P-256 nunca sai da sua máquina ou do GitHub Actions. Os módulos nativos validam a assinatura criptográfica contra a chave pública gravada no <code>Info.plist</code> e <code>strings.xml</code> antes de ativar qualquer arquivo.
              </p>
            </details>
            <details>
              <summary>
                <span>Funciona com Bare React Native e Nova Arquitetura (Fabric / TurboModules)?</span>
                <svg class="pumpy-faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p>
                Sim! Suporta React Native 0.71 até 0.87+, Antiga e Nova Arquitetura, Hermes (bytecode <code>.hbc</code>) e JSC, tanto em projetos Bare React Native quanto com Expo (via config plugin <code>"react-native-airdrop/expo"</code>).
              </p>
            </details>
            <details>
              <summary>
                <span>Como funciona o deploy na minha própria AWS e Cloudflare?</span>
                <svg class="pumpy-faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p>
                O repositório inclui <code>bash scripts/deploy-aws.sh</code> para provisionar S3 + CloudFront + AWS Lambda Function URL em <code>us-east-2</code> e configuração pronta do Wrangler para Cloudflare Workers + D1 + R2 no seu próprio domínio.
              </p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <!-- SIGNATURE GIANT PEEKING MASCOT FOOTER (PUMPY STYLE) -->
    <footer class="pumpy-site-footer" id="contato">
      <div class="pumpy-footer-character" aria-hidden="true">
        <svg viewBox="0 0 120 120" width="100%" height="100%" style="overflow: visible; display: block;">
          <path
            d="M22 46 C22 20, 98 20, 98 46 C98 52, 91 55, 84 53 C76 51, 68 51, 60 53 C52 51, 44 51, 36 53 C29 55, 22 52, 22 46 Z"
            fill="var(--pumpy-body)"
          />
          <line x1="33" y1="50" x2="42" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
          <line x1="87" y1="50" x2="78" y2="63" stroke="var(--pumpy-body)" stroke-width="4.5" stroke-linecap="round" />
          <rect x="26" y="56" width="68" height="50" rx="25" fill="var(--pumpy-body)" />
          <g id="footer-mascot-eyes">
            <ellipse cx="47" cy="76" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
            <ellipse cx="73" cy="76" rx="4.8" ry="6.2" fill="var(--pumpy-eyes)" />
          </g>
        </svg>
      </div>

      <div class="pumpy-footer-messages" aria-hidden="true">
        <p class="pumpy-footer-bubble">
          Vai esperar 48h pela<br />revisão da loja, né?
        </p>
        <p class="pumpy-footer-bubble pumpy-footer-bubble-followup">
          …né? 😠
        </p>
      </div>

      <div class="pumpy-footer-content">
        <a class="pumpy-footer-wordmark" href="#">
          Airdrop<span>®</span>
        </a>
        <p style="color: var(--muted); font-size: 17px; line-height: 1.5; margin: 18px 0 34px; max-width: 440px;">
          Uma nova forma de publicar no React Native.<br />
          Receba seu token ou faça deploy na sua conta AWS + Cloudflare.
        </p>

        <div style="max-width: 480px; margin-bottom: 44px;">
          <form class="pumpy-beta-form" data-waitlist-form style="padding: 0; margin: 0;" aria-label="Lista de acesso Airdrop">
            <label class="pumpy-beta-label" for="footer-email">
              <span>Entre na lista de acesso</span>
            </label>
            <div class="pumpy-beta-row">
              <input
                id="footer-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="Seu melhor e-mail"
                maxlength="254"
                required
              />
              <button class="pumpy-button" type="submit">
                Quero participar <span aria-hidden="true">↗</span>
              </button>
            </div>
            <div style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);" aria-hidden="true">
              <input name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="waitlist-status" style="font-size: 12px; margin-top: 10px; color: var(--mint); display: none;"></p>
          </form>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 18px 28px; font-size: 13px; color: var(--muted-strong);">
          <a href="/dashboard/" style="color: inherit; text-decoration: none;">Release Console</a>
          <a href="/docs/getting-started/" style="color: inherit; text-decoration: none;">Getting Started</a>
          <a href="/docs/security/" style="color: inherit; text-decoration: none;">Segurança ECDSA</a>
          <a href="/docs/cli/" style="color: inherit; text-decoration: none;">Referência CLI</a>
          <a href={GITHUB} style="color: inherit; text-decoration: none;">GitHub (MIT)</a>
          <a href="/privacy/" style="color: inherit; text-decoration: none;">Privacidade</a>
          <a href="/terms/" style="color: inherit; text-decoration: none;">Termos</a>
        </div>
        <p style="font-size: 11px; color: var(--muted); margin-top: 18px; font-family: monospace;">
          airdrop.guhcostan.dev · airdrop-api.guhcostan.dev · AWS us-east-2 + Cloudflare Edge
        </p>
      </div>
    </footer>

    <!-- PUMPY TOAST NOTIFICATION -->
    <div
      id="pumpy-toast"
      role="status"
      aria-live="polite"
      hidden
      style="
        position: fixed;
        z-index: 100;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border: 1px solid #43996d;
        border-radius: 18px;
        background: #153f2b;
        color: #d9ffe7;
        box-shadow: 0 8px 32px #0004;
        font-size: 14px;
      "
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#91e8b3" stroke-width="2">
        <circle cx="12" cy="12" r="9" />
        <path d="m8 12 3 3 5-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span id="pumpy-toast-text">Você entrou para a lista!</span>
    </div>

    <script is:inline define:vars={{ API }}>
      // 1. Capsule Scroll Navigation
      const header = document.getElementById("site-header");
      const syncScroll = () => {
        if (!header) return;
        header.classList.toggle("is-scrolled", window.scrollY > 28);
      };
      window.addEventListener("scroll", syncScroll, { passive: true });
      syncScroll();

      // 2. Theme Toggle (Dark <-> Light, Pumpy palette)
      const themeBtn = document.getElementById("theme-toggle");
      themeBtn?.addEventListener("click", () => {
        const html = document.documentElement;
        const next = html.getAttribute("data-theme") === "light" ? "dark" : "light";
        html.setAttribute("data-theme", next);
        html.classList.toggle("dark", next === "dark");
      });

      // 3. Living Hero & Footer Mascot Eye Tracking + Click Hop/Wink
      const heroMascotBtn = document.getElementById("hero-mascot-btn");
      const heroEyes = document.getElementById("hero-mascot-eyes");
      const footerEyes = document.getElementById("footer-mascot-eyes");
      const leftEye = document.getElementById("hero-eye-left");

      window.addEventListener(
        "mousemove",
        (e) => {
          const gx = Math.max(-5.5, Math.min(5.5, ((e.clientX / window.innerWidth) - 0.5) * 12));
          const gy = Math.max(-4, Math.min(4, ((e.clientY / window.innerHeight) - 0.5) * 9));
          if (heroEyes) heroEyes.setAttribute("transform", `translate(${gx.toFixed(2)}, ${gy.toFixed(2)})`);
          if (footerEyes) footerEyes.setAttribute("transform", `translate(${(gx * 0.8).toFixed(2)}, ${(gy * 0.8).toFixed(2)})`);
        },
        { passive: true }
      );

      heroMascotBtn?.addEventListener("click", () => {
        heroMascotBtn.classList.remove("is-hopping");
        void heroMascotBtn.offsetWidth;
        heroMascotBtn.classList.add("is-hopping");
        if (leftEye) {
          leftEye.setAttribute("ry", "1.2");
          setTimeout(() => leftEye.setAttribute("ry", "6.2"), 420);
        }
      });

      // Periodic natural blink
      setInterval(() => {
        if (!leftEye) return;
        const rightEye = document.getElementById("hero-eye-right");
        leftEye.setAttribute("ry", "0.8");
        rightEye?.setAttribute("ry", "0.8");
        setTimeout(() => {
          leftEye.setAttribute("ry", "6.2");
          rightEye?.setAttribute("ry", "6.2");
        }, 140);
      }, 4600);

      // 4. Copy CLI command in Hero
      const copyHeroCli = document.getElementById("copy-hero-cli");
      const copyHeroBadge = document.getElementById("copy-hero-cli-badge");
      copyHeroCli?.addEventListener("click", () => {
        navigator.clipboard?.writeText("npx react-native-airdrop-cli release --platform ios --rollout 20 --sign");
        if (copyHeroBadge) {
          copyHeroBadge.textContent = "✓ copiado!";
          copyHeroBadge.style.color = "var(--mint)";
          setTimeout(() => {
            copyHeroBadge.textContent = "copiar";
            copyHeroBadge.style.color = "var(--muted)";
          }, 1800);
        }
      });

      // 5. Waitlist Form Submission -> POST /v1/waitlist + Pumpy Toast
      const toast = document.getElementById("pumpy-toast");
      document.querySelectorAll("[data-waitlist-form]").forEach((form) => {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const f = e.currentTarget;
          const fd = new FormData(f);
          const email = String(fd.get("email") || "").trim();
          const company = String(fd.get("company") || "");
          const btn = f.querySelector("button[type='submit']");
          const status = f.querySelector(".waitlist-status");
          if (btn) btn.disabled = true;
          try {
            const res = await fetch(`${API}/v1/waitlist`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ email, company }),
            });
            if (!res.ok && res.status !== 202) throw new Error("Falha ao enviar");
            f.reset();
            if (status) {
              status.style.display = "block";
              status.textContent = "✓ Você entrou para a lista! Enviaremos seu token em breve.";
            }
            if (toast) {
              toast.hidden = false;
              setTimeout(() => {
                toast.hidden = true;
              }, 4000);
            }
          } catch {
            if (status) {
              status.style.display = "block";
              status.textContent = "Recebido! Você também pode testar o Console Interativo agora em /dashboard.";
            }
          } finally {
            if (btn) btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
